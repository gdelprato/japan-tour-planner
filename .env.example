# Variabili d'ambiente del progetto (S05). Copiare in .env e compilare: .env non va mai committato.
# L'app web statica in app/ NON legge nessuna di queste variabili: servono solo agli script
# della pipeline dei prezzi (scripts/), ai test e, in futuro, al proxy serverless (worker/).

# Ambiente
ENVIRONMENT=dev                 # dev | prod
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR

# Modelli (agente dati, contenuti generati al build, eval): piano §6
ANTHROPIC_API_KEY=              # Chiave API Anthropic, da console.anthropic.com

# Pipeline dei prezzi: piano §5.9 (ogni fonte è opzionale finché il job corrispondente non esiste)
RAKUTEN_APP_ID=                 # ID applicazione Rakuten Web Service, per i prezzi degli hotel
TRAVELPAYOUTS_TOKEN=            # Token Travelpayouts Data API, per i prezzi minimi dei voli
AMADEUS_CLIENT_ID=              # In alternativa a Travelpayouts
AMADEUS_CLIENT_SECRET=

# Proxy serverless (Cloudflare Worker, ADR-004): solo per il deploy del worker, mai nel browser
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Test di integrazione
PLAYWRIGHT_CHROMIUM_EXECUTABLE= # Percorso di un Chromium già installato, se non si vuole scaricarlo
